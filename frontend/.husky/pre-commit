#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run GraphQL schema validation
echo "🔍 Validating GraphQL schema..."
yarn validate-schema

# Run comprehensive GraphQL operations test
echo "🧪 Testing GraphQL operations..."
yarn test:graphql-operations

# Run frontend tests
echo "🧪 Running frontend tests..."
yarn test:run

echo "✅ All validations passed!" 